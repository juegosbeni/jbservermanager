<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Botón Copiar</title>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: "Segoe UI", sans-serif;
    }

    body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #eef8ff, #d9f0ff);
    }

    .copy-btn {
        background: linear-gradient(135deg, #7dd3fc, #38bdf8);
        color: white;
        border: none;
        border-radius: 16px;
        padding: 16px 32px;
        font-size: 18px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 10px 25px rgba(56, 189, 248, 0.35);
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .copy-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(56, 189, 248, 0.45);
    }

    .copy-btn:active {
        transform: translateY(0);
    }

    .copy-btn.copied {
        background: linear-gradient(135deg, #4ade80, #22c55e);
    }

    .icon {
        font-size: 20px;
    }
</style>
</head>
<body>

<button id="copyButton" class="copy-btn">
    <span class="icon">📋</span>
    <span id="buttonText">Copiar texto</span>
</button>

<script>
const textoACopiar = "https://juegosbeni.github.io/jbservermanager/download/installer";

document.getElementById("copyButton").addEventListener("click", async () => {
    const boton = document.getElementById("copyButton");
    const texto = document.getElementById("buttonText");

    try {
        await navigator.clipboard.writeText(textoACopiar);

        boton.classList.add("copied");
        texto.textContent = "¡Copiado!";

        setTimeout(() => {
            boton.classList.remove("copied");
            texto.textContent = "Copiar texto";
        }, 2000);

    } catch (error) {
        texto.textContent = "Error al copiar";
    }
});
</script>

</body>
</html>
